// One planner per deck. Deploy with `npx wrangler deploy -c wrangler.jsonc`, then `npx wrangler secret put RUN_TOKEN`.
{
  "name": "cert-planner-<deck>",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "triggers": { "crons": ["*/10 * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "<etude-sync D1 name>", "database_id": "<id>" }],
  "vars": {
    "ACCOUNT_EMAIL": "learner@example.com",
    "ITEM_PREFIX": "sfa",
    "TYPE_PREFIX": "sfl",
    "RELEASE_DAYS": "3",
    "LEARNING_STEPS": "2",
    "RELEARNING_STEPS": "1",
    "TZ": "Europe/Amsterdam",
    "DAY_START_HOUR": "4"
  }
}
